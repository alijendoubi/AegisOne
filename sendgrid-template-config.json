{
  "template_name": "AegisOne Welcome Email",
  "subject": "🛡️ Welcome to AegisOne - Your AI Security Agent",
  "template_variables": {
    "firstName": {
      "type": "string",
      "description": "User's first name extracted from email",
      "default": "there",
      "example": "John"
    },
    "platform": {
      "type": "string", 
      "description": "User's selected platform",
      "default": "your platform",
      "example": "Windows"
    },
    "websiteUrl": {
      "type": "string",
      "description": "Main website URL",
      "default": "https://aegisone.com",
      "example": "https://aegisone.com"
    },
    "unsubscribeUrl": {
      "type": "string",
      "description": "Unsubscribe link (auto-generated by SendGrid)",
      "default": "{{unsubscribe}}",
      "example": "https://unsubscribe.sendgrid.com/..."
    }
  },
  "test_data": {
    "personalizations": [
      {
        "to": [{"email": "test@example.com", "name": "Test User"}],
        "dynamic_template_data": {
          "firstName": "John",
          "platform": "Windows",
          "websiteUrl": "https://aegisone.com",
          "unsubscribeUrl": "https://unsubscribe.sendgrid.com/test"
        }
      }
    ],
    "from": {
      "email": "noreply@aegisone.com",
      "name": "AegisOne"
    },
    "reply_to": {
      "email": "support@aegisone.com",
      "name": "AegisOne Support"
    }
  },
  "template_settings": {
    "generate_plain_content": true,
    "track_clicks": true,
    "track_opens": true,
    "bypass_list_management": false,
    "bypass_spam_management": false,
    "bypass_bounce_management": false,
    "bypass_unsubscribe_management": false
  }
}
